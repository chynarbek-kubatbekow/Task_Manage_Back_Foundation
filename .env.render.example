# Backend Render + Neon. Не коммитьте файл с настоящими значениями.
DJANGO_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com
DJANGO_TIME_ZONE=Asia/Almaty
DJANGO_LOG_LEVEL=INFO

# Вставьте pooled connection string из Neon целиком.
DATABASE_URL=postgresql://USER:PASSWORD@EP-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Точный публичный URL frontend без завершающего слеша.
CORS_ALLOWED_ORIGINS=https://fundament-web.onrender.com
CSRF_TRUSTED_ORIGINS=https://fundament-web.onrender.com

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Создаются автоматически при первом старте backend.
BOOTSTRAP_COMPANY_NAME=Fundament
BOOTSTRAP_COMPANY_SLUG=fundament
BOOTSTRAP_ADMIN_USERNAME=owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
