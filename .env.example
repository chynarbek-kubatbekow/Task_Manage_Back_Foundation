# Локальная разработка Django
DJANGO_SECRET_KEY=local-development-secret-change-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Almaty
DJANGO_LOG_LEVEL=INFO

# Локальный Vite frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Локально оставьте пустым для SQLite. На Render это поле обязательно.
DATABASE_URL=

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Первоначальная компания и владелец
BOOTSTRAP_COMPANY_NAME=Fundament Demo
BOOTSTRAP_COMPANY_SLUG=fundament-demo
BOOTSTRAP_ADMIN_USERNAME=owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
