# Скопируйте этот файл в .env:
# Copy-Item .env.example .env

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# В production используйте длинный случайный ключ и никогда не коммитьте .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-at-least-50-characters

# Локально: True. На сервере: False.
DJANGO_DEBUG=True

# Домены без http:// и https://, через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Almaty

# Адреса frontend с протоколом. Не добавляйте / в конце.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# На production включите True после настройки HTTPS/reverse proxy.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# База данных Neon — рекомендуемый вариант
# -----------------------------------------------------------------------------
# Neon Console -> Project -> Connect -> выберите pooled connection и скопируйте
# Connection string целиком. В ней уже находятся user, password, host и dbname.
# Пример формата (это не рабочий ключ):
# postgresql://neondb_owner:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# DATABASE_URL имеет приоритет над POSTGRES_* ниже.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Обычный PostgreSQL — используйте только если DATABASE_URL пустой
# -----------------------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Если DATABASE_URL и POSTGRES_DB пустые, Django автоматически использует
# локальный файл SQLite db.sqlite3. Это удобно только для разработки.
